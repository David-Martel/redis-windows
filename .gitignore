# Build artifacts - .NET (root-relative to avoid matching agent-sync/src/bin/)
/bin/
/obj/
/publish/

# Build artifacts - Rust
agent-sync/target/

# Compiled binaries (downloaded/built separately)
*.exe
*.dll
*.pdb

# Configuration files with secrets
.env
.env.local
.env.production

# IDE and editor files
.vs/
*.swp
*.swo
*~

# Redis data and logs
*.rdb
*.aof
redis.log
dump.rdb
appendonly.aof

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp

# Package managers
node_modules/
packages/

# Logs
logs/
*.log

# Runtime files
*.pid
redis.lock

# Cargo.lock is tracked for reproducible service binary builds
!agent-sync/Cargo.lock

# Redis download/extract artifacts
Redis-*.zip
redis-[0-9]*/

# Deprecated artifacts
*.old
*.broken
agent-sync/clippy_output.txt

# Taskmaster
.taskmaster/
